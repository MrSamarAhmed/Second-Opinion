# Captured Qloo API responses stay local and out of the public repository.
data/

__pycache__/
*.py[cod]
.DS_Store
.venv/
*.log

# Credentials never enter the repository.
.env
.env.*
!.env.example

# Local clean-checkout scratch space, kept on disk but never published.
.clean_check/

# Local-only development artifacts: analysis output files and the modules that
# read the captured responses. They stay outside this repository; the patterns
# below are guards against an accidental copy being committed, not an inventory.
/citytaste/*.txt
/citytaste/analyze.py
/second_opinion/study.py
/scripts/
/docs/LIVE_INTEGRATION.md
